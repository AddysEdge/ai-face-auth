# =========================================================================
# Python
# =========================================================================
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
*.egg-info/
build/
dist/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.pytest_tmp/
.coverage
htmlcov/
.tox/

# =========================================================================
# Runtime data - biometric templates, enrolled state, rate-limit state,
# logs, dev encryption keys. NEVER commit any of it. See docs/THREAT_MODEL.md.
# =========================================================================
data/
*.template
*.dpapi
templates/
# B18 participant data - session manifests, Stage 0 workspaces, and any analysis
# output derived from them. The tooling in scripts/b18_stage0/ can produce these;
# none of it may ever be committed (docs/B18_REAL_INPUT_VALIDATION_PLAN.md 11.3).
# Only a verified aggregate, non-identifying report may be committed, and only
# under owner decision D16 - so that is deliberately NOT excepted here.
b18_data/
b18_workspace/
*.manifest.json
S[0-9][0-9].json
S[0-9][0-9][0-9].json
enrollment/
*.embedding
*.npy

# Runtime authentication / verification state (Phase 2 designs a pre-logon
# store; nothing writes one yet, but the ignore lands before the code does).
faceauth_state/
*.authstate

# =========================================================================
# Logs
# =========================================================================
logs/
*.log
*.log.*

# =========================================================================
# Model weights - fetched via scripts/fetch_models.py, checksum-pinned in
# src/faceauth/model_registry.py. Never committed.
# =========================================================================
models/*.onnx
models/*.task
models/*.tflite
models/*.pb
models/*.pt
models/*.pth
models/*.bin
models/*.safetensors

