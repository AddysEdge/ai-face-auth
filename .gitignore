*.key
*.pfx
*.p12
*.cer
*.crt
*.der
*.jks
*.keystore
*.reg
secrets.json
.env
.env.*
!.env.example

# =========================================================================
# Native build output (native/) - CMake, MSVC, object files, binaries,
